# Copy to .env and supply local secrets. Never commit .env.
NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/kokoro?replicaSet=rs0
SESSION_SECRET=
ADMIN_USER=
# Obtain with: node scripts/hash-admin.js --write
ADMIN_PASSWORD_HASH=
SITE_URL=http://localhost:3000
# Exact reverse proxy IPs/CIDRs, comma separated. Production defaults to loopback Nginx.
# Use false for direct HTTPS without a proxy; do not use true or a hop count.
TRUST_PROXY=127.0.0.1/32,::1/128
BOOKING_WRITES_ENABLED=true
WORKER_ENABLED=true
# Use true on staging first; false enforces CSP.
CSP_REPORT_ONLY=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
ADMIN_EMAIL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET is also supported instead of CLOUDINARY_SECRET.
CLOUDINARY_SECRET=
