<!DOCTYPE html>
<html lang="<%= locale %>"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= pageTitle %></title><link rel="stylesheet" href="<%= asset('site.css') %>">
</head><body class="bg-bgBase text-main pb-36">
<header class="flex justify-center bg-white shadow-sm p-3"><a href="/"><img src="<%= asset('logo-320.webp') %>" srcset="<%= asset('logo-320.webp') %> 1x, <%= asset('logo-640.webp') %> 2x" alt="Kokoro" class="h-14" width="160" height="56"></a></header>
<main class="max-w-[1100px] mx-auto p-5">
<h1 class="text-2xl font-bold my-5"><%= __('booking.nav.step3') %></h1>
<% if (error) { %><p role="alert" class="border border-amber-300 bg-amber-50 p-4 rounded-xl mb-5"><%= error %></p><% } %>
<form action="<%= action %>" method="POST" data-booking-review data-base-total="<%= baseTotal %>">
<input type="hidden" name="csrfToken" value="<%= csrfToken %>">
<input type="hidden" name="quote" value="<%= quote %>">
<input type="hidden" name="shopId" value="<%= shop.id %>">
<input type="hidden" name="totalQuantity" value="<%= bookingInfo.totalQuantity %>">
<% if (action === '/booking') { %><input type="hidden" name="quantity" value="<%= bookingInfo.totalQuantity %>"><% } %>
<div class="grid lg:grid-cols-[1fr_350px] gap-8">
<div>
<section class="bg-white rounded-2xl p-5 space-y-4 border border-gray-200">
<h2 class="font-bold text-lg"><%= __('booking.step3.info_title') %></h2>
<% [['fullname',120,'text','name'],['email',254,'email','email'],['phone',40,'tel','tel']].forEach(([field,max,type,autocomplete]) => { %>
<label class="block"><span class="block mb-2 font-semibold"><%= __('booking.step3.' + field) %> *</span>
<input name="<%= field %>" type="<%= type %>" maxlength="<%= max %>" autocomplete="<%= autocomplete %>" required value="<%= values[field] || '' %>" class="w-full border border-gray-300 rounded-lg p-3"></label>
<% }) %>
</section>
<%- include('partials/booking-slots', { dateValue: bookingInfo.date, timeValue: bookingInfo.time }) %>
<% plansData.forEach(plan => { for (let i=1; i<=plan.qty; i++) { const key = 'options_' + plan.id + '_' + i; const selected = Array.isArray(selectedOptions[key]) ? selectedOptions[key] : [selectedOptions[key]]; %>
<details class="bg-white p-4 rounded-xl border border-gray-200 my-3"><summary class="cursor-pointer font-semibold"><%= plan.title %> · <%= ui.guests %> <%= i %></summary>
<div class="grid gap-3 mt-4">
<% options.forEach(option => { %><label class="flex gap-3 items-start"><input type="checkbox" name="<%= key %>" value="<%= option.id %>" class="option-checkbox mt-1" data-price="<%= option.price %>" <%= selected.includes(option.id) ? 'checked' : '' %>><span><%= ui.optionNames[option.id] || option.name %> — JPY <%= option.price %></span></label><% }) %>
</div></details>
<% } }) %>
</div>
<aside><div class="bg-white rounded-2xl p-6 border border-gray-200 lg:sticky lg:top-6">
<h2 class="text-xl font-bold mb-4"><%= __('booking.step3.payment_details') %></h2>
<p class="mb-3"><%= shop.name %></p><p class="text-sm text-accent mb-4"><%= ui.timezone %></p>
<ul class="divide-y"><% plansData.forEach(plan => { %><li class="py-3 flex justify-between gap-4"><span><%= plan.title %> × <%= plan.qty %></span><span>JPY <%= plan.subTotal.toLocaleString('ja-JP') %></span></li><% }) %></ul>
<p class="font-bold text-xl my-5">JPY <span data-final-total><%= baseTotal.toLocaleString('ja-JP') %></span></p>
<button type="submit" disabled class="w-full rounded-full bg-accent text-white p-3 font-bold disabled:opacity-50"><%= ui.submit %></button>
</div></aside>
</div>
<div class="fixed bottom-0 left-0 w-full bg-white border-t p-4 flex justify-between items-center gap-4 lg:hidden"><span class="font-bold">JPY <span data-final-total><%= baseTotal.toLocaleString('ja-JP') %></span></span><button type="submit" disabled class="rounded-full bg-accent text-white px-5 py-3 disabled:opacity-50"><%= ui.submit %></button></div>
</form></main><script src="<%= asset('booking-total.js') %>" defer></script></body></html>
